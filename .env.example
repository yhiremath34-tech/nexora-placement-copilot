# NEXORA ENVIRONMENT CONFIGURATION
# Client-side variables (prefixed with VITE_) are accessible in the browser.
# Sensitive keys (GEMINI_API_KEY, SUPABASE_SERVICE_ROLE_KEY) MUST NEVER be placed in client code.

# Supabase Client Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Demo Fixture Mode (true/false)
# Set to true to test full offline flows when external APIs are not reachable
VITE_DEMO_MODE=false

# Server-Side Only Keys (e.g. Supabase Edge Functions or Local Agent Server)
# NEVER commit real keys or expose them to the browser client!
GEMINI_API_KEY=your-gemini-api-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
